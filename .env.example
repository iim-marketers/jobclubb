NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Project Settings → API Keys → Secret keys). Creates
# accounts, generates confirmation links and stores student IDs. Never prefix
# it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Used in email links. Set to the live domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nodemailer SMTP (Gmail: smtp.gmail.com, your Gmail address, and a 16-character
# app password from https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JobClubb <you@gmail.com>"

# Stub payments: "Pay" activates membership without charging. Always on in `next dev`.
# Set to true only on test deployments, never in production.
PAYMENTS_TEST_MODE=false

# ATS resume builder (candidate dashboard → My resume). Server-only.
OPENAI_API_KEY=
# Any model that supports structured outputs on the Responses API.
OPENAI_MODEL=gpt-5-mini
