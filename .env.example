NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=
DATABASE_URL=

# Used in email links and auth redirects.
# Production: https://www.jobclubb.com (also the fallback when unset in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production email (NODE_ENV=production). RESEND_FROM must use a domain verified in Resend,
RESEND_API_KEY=
RESEND_FROM=

# Local/development email: Gmail SMTP with a 16-character Gmail app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ATS resume builder (candidate dashboard → My resume). Server-only.
OPENAI_API_KEY=
# Any model that supports structured outputs on the Responses API.
OPENAI_MODEL=gpt-5-mini

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Admin console (/admin/login). Single admin account; changing the password signs the admin out.
ADMIN_EMAIL=
ADMIN_PASSWORD=
