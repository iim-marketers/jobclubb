NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=
DATABASE_URL=

# Used in email links. Set to the live domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend. RESEND_FROM must use a domain verified in Resend, e.g. "JobClubb <no-reply@mail.example.com>".
RESEND_API_KEY=
RESEND_FROM=

# ATS resume builder (candidate dashboard → My resume). Server-only.
OPENAI_API_KEY=
# Any model that supports structured outputs on the Responses API.
OPENAI_MODEL=gpt-5-mini

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
