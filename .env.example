NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=
DATABASE_URL=

# Used in email links and auth redirects.
# Production: https://www.jobclubb.com (also the fallback when unset in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# All email (local and production) goes through Resend. RESEND_FROM must use a domain verified in Resend,
# e.g. "JobClubb <no-reply@jobclubb.com>".
RESEND_API_KEY=
RESEND_FROM=

# ATS resume builder (candidate dashboard → My resume). Server-only.
OPENAI_API_KEY=
# Any model that supports structured outputs on the Responses API.
OPENAI_MODEL=gpt-5-mini

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Admin console (/admin/login). Single admin account; changing the password signs the admin out.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Footer social links. Leave empty to hide the icon. Inlined at build time.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
